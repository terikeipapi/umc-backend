{
  "info": {
    "_postman_id": "38074742-cc8b-4c06-8e46-11c303a7f5e9",
    "name": "UMC 7주차 - 로그인한 사용자를 구분하기",
    "description": "본문 실습 1~6과 필수 9단계 시나리오. 01~11 요청이 PDF 62쪽의 9단계(가입/로그인은 A,B각각)를 순서대로 수행합니다. 12~23은 내정보/변조/로그인실패/입력검증 추가실습입니다. 처음 요청이 매번 새 예시회원 값을 만들고 토큰과 ID를 저장합니다. 실제 JWT 비밀키나 DB비밀번호를 넣지 마세요. 토큰은 실행중 환경값에만 저장하며 제공 Environment파일은 비어있습니다. 없는 ratingId=99999가 실제존재하면 테스트용 DB에서 없는값으로바꾸세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 준비 - 회원 A 가입",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "const tag = pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0, 8);",
              "pm.environment.set(\"runTag\", tag);",
              "pm.environment.set(\"emailA\", \"postman7-\" + tag + \"-a@example.com\");",
              "pm.environment.set(\"emailB\", \"postman7-\" + tag + \"-b@example.com\");",
              "pm.environment.set(\"nicknameA\", \"a\" + tag);",
              "pm.environment.set(\"nicknameB\", \"b\" + tag);",
              "pm.environment.set(\"updatedNickname\", \"n\" + tag);",
              "[\"memberIdA\",\"memberIdB\",\"ratingId\",\"tokenA\",\"tokenB\",\"tamperedToken\",\"createdAt\",\"unknownFailure\"].forEach(function (key) { pm.environment.unset(key); });",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const responseData = pm.response.json();",
              "pm.test(\"공통 응답 형식\", function () { pm.expect(Object.keys(responseData).sort()).to.eql([\"code\", \"isSuccess\", \"message\", \"result\"]); pm.expect(responseData.message).to.be.a(\"string\"); });",
              "pm.test(\"isSuccess\", function () { pm.expect(responseData.isSuccess).to.eql(true); });",
              "pm.test(\"응답에 비밀번호 없음\", function () { pm.expect(pm.response.text()).not.to.match(/\"password\"\\s*:/); });",
              "pm.test(\"응답 code COMMON201\", function () { pm.expect(responseData.code).to.eql(\"COMMON201\"); });",
              "if(pm.response.code===201) pm.environment.set(\"memberIdA\", responseData.result.memberId);",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/members",
        "description": "01 준비 - 회원 A 가입",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"{{nicknameA}}\"\n}",
          "options": {
