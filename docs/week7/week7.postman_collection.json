    {
      "name": "03 로그인 - 회원 A accessToken",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const responseData = pm.response.json();",
              "pm.test(\"공통 응답 형식\", function () { pm.expect(Object.keys(responseData).sort()).to.eql([\"code\", \"isSuccess\", \"message\", \"result\"]); pm.expect(responseData.message).to.be.a(\"string\"); });",
              "pm.test(\"isSuccess\", function () { pm.expect(responseData.isSuccess).to.eql(true); });",
              "pm.test(\"응답에 비밀번호 없음\", function () { pm.expect(pm.response.text()).not.to.match(/\"password\"\\s*:/); });",
              "pm.test(\"응답 code COMMON200\", function () { pm.expect(responseData.code).to.eql(\"COMMON200\"); });",
              "pm.test(\"로그인 응답과 토큰\", function () { pm.expect(Object.keys(responseData.result).sort()).to.eql([\"accessToken\",\"nickname\"]); pm.expect(responseData.result.accessToken.split(\".\")).to.have.length(3); });",
              "if(pm.response.code===200) pm.environment.set(\"tokenA\", responseData.result.accessToken);",
              "if(pm.response.code===200) { const parts=responseData.result.accessToken.split(\".\"); parts[1]=(parts[1][0]===\"e\"?\"f\":\"e\")+parts[1].slice(1); pm.environment.set(\"tamperedToken\", parts.join(\".\")); }",
              "})();"
            ]
          }
        }
      ],
