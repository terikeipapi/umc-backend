{
  "info": {
    "_postman_id": "b82d7ec8-3cd2-4bf3-82e9-d1e2d0473349",
    "name": "UMC 6주차 - 회원가입과 영화 평점",
    "description": "NestJS Standard Mission 재현. Environment를 선택하고 순서대로 실행합니다. 첫 요청은 새 runTag를 생성하고 ID를 저장합니다. 로컬 DB에 데모 회원 2명을 생성하며, 마지막 단계에서 데모 평점을 삭제합니다. 4294967295는 없는 회원/평점 확인용 ID로 사용합니다. 해당 ID가 실제 존재하는 데이터셋에서는 없는 ID로 바꾸세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 회원가입 성공 및 memberId 저장",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const tag = pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0, 8);",
              "pm.environment.set(\"runTag\", tag);",
              "pm.environment.unset(\"memberId\");",
              "pm.environment.unset(\"otherMemberId\");",
              "pm.environment.unset(\"ratingId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test(\"공통 응답 필드\", function () { pm.expect(Object.keys(data).sort()).to.eql([\"code\", \"isSuccess\", \"message\", \"result\"]); pm.expect(data.message).to.be.a(\"string\"); });",
              "pm.test(\"성공/실패 구분\", function () { pm.expect(data.isSuccess).to.eql(true); });",
              "pm.test(\"비밀번호 응답 제외\", function () { pm.expect(pm.response.text()).not.to.match(/\"password\"\\s*:/); });",
              "pm.test(\"회원 응답 DTO\", function () { pm.expect(Object.keys(data.result).sort()).to.eql([\"email\", \"memberId\", \"nickname\"]); pm.expect(data.result.memberId).to.be.a(\"number\"); });",
              "if (pm.response.code === 201) pm.environment.set(\"memberId\", data.result.memberId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/members",
        "description": "01 회원가입 성공 및 memberId 저장",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"week6.{{runTag}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"u{{runTag}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 이메일 형식 검증 실패",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "const data = pm.response.json();",
              "pm.test(\"공통 응답 필드\", function () { pm.expect(Object.keys(data).sort()).to.eql([\"code\", \"isSuccess\", \"message\", \"result\"]); pm.expect(data.message).to.be.a(\"string\"); });",
              "pm.test(\"성공/실패 구분\", function () { pm.expect(data.isSuccess).to.eql(false); });",
              "pm.test(\"비밀번호 응답 제외\", function () { pm.expect(pm.response.text()).not.to.match(/\"password\"\\s*:/); });",
              "pm.test(\"실패 result는 null\", function () { pm.expect(data.result).to.eql(null); });",
              "pm.test(\"업무 오류 코드\", function () { pm.expect(data.code).to.eql(\"COMMON4001\"); });"
            ]
          }
        }
      ],
